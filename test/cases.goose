// check_captures checks the capture cases of Node micromatch.
fn check_captures() {
    capture_case("a*b*c", "axbyc", 2, "x\ny");
    capture_case("*.txt", "aXbYbZc", -1, "");
    capture_case("a/*/c.txt", "notes.txt", -1, "");
    capture_case("a/*", "a/b/c.txt", -1, "");
    capture_case("a?c", "a/b/c", -1, "");
    capture_case("a[bc]c", "abc", 1, "b");
    capture_case("{a,b}", "a", 1, "a");
    capture_case("**", "a/b/c", 1, "a/b/c");
    capture_case("a/**/c.txt", "b", -1, "");
    capture_case("a/**", "ac", -1, "");
    capture_case("**/*.goose", "abd", -1, "");
    capture_case("{a,b}{c,d}", "za", -1, "");
    capture_case("a{b,c}d", "ab", -1, "");
    capture_case("{a,{b,c}}", "ba", -1, "");
    capture_case("{*a,b}", "b.txt", -1, "");
    capture_case("*{a,b}", "src/app.goose", -1, "");
    capture_case("a*b", "x5y", -1, "");
    capture_case("*a*", "x.goose", -1, "");
    capture_case("*", "a/b", -1, "");
    capture_case("?.txt", "src/deep/x.goose", -1, "");
    capture_case("?.goose", "x", -1, "");
    capture_case("[abc]c", "y", -1, "");
    capture_case("[abc]*", "axc", 2, "a\nxc");
    capture_case("x[0-9]y", "b/c", -1, "");
    capture_case("src/*.goose", "a/b/c.txt", -1, "");
    capture_case("a/*b*", "notes.md", -1, "");
    capture_case("*/*", "a.txt", -1, "");
    capture_case("{a,b}/*", "b.goose", -1, "");
    capture_case("{a,b}/*.txt", "axbxc", -1, "");
    capture_case("a/**/b", "axbxxc", -1, "");
    capture_case("**/x", "data1.csv", -1, "");
