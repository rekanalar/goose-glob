    capture_case("*", "x5y", 1, "x5y");
    capture_case("?.txt", "x.goose", -1, "");
    capture_case("?.goose", "a/b", -1, "");
    capture_case("[abc]c", "src/deep/x.goose", -1, "");
    capture_case("[abc]*", "x", -1, "");
    capture_case("x[0-9]y", "y", -1, "");
    capture_case("src/*.goose", "axc", -1, "");
    capture_case("a/*b*", "b/c", -1, "");
    capture_case("*/*", "a/b/c.txt", -1, "");
    capture_case("{a,b}/*", "notes.md", -1, "");
    capture_case("{a,b}/*.txt", "a.txt", -1, "");
    capture_case("a/**/b", "b.goose", -1, "");
    capture_case("**/x", "axbxc", -1, "");
    capture_case("x/**/y", "axbxxc", -1, "");
    capture_case("*?*", "data1.csv", 2, "\nata1.csv");
    capture_case("*.goose", "x.md", -1, "");
    capture_case("?.?", "src/a/b/c.goose", -1, "");
    capture_case("*/*/*", "a/b/c/d", -1, "");
    capture_case("a/b/c.txt", "axbyc", -1, "");
}
