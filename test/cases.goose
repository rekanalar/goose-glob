// The cases of the name match and the capture.
//
// The expected results come from Python fnmatch and Node
// micromatch. A case that the references do not agree on
// does not belong here.

namespace cases;

import std;
import glob from "..";

// name_case checks one case of the name match.
fn name_case(pattern: u8[:], name: u8[:], want: bool) {
    assert(glob::match_name(name, pattern) == want);
}

// capture_case checks one case of the capture.
// The parts come in the out string, separated by a newline.
fn capture_case(pattern: u8[:], text: u8[:], count: i64,
    parts: u8[:]) {
    var out: u8[>..] = [];
    let n = glob::capture(out, text, pattern);
    assert(n == count);
    assert(out == parts);
}

// check_names checks the name cases of Python fnmatch.
fn check_names() {
    name_case("*", "notes.txt", true);
    name_case("*.txt", "notes.md", false);
    name_case("?.txt", "main.goose", false);
    name_case("a*", "src/main.goose", false);
    name_case("*a", "a", true);
    name_case("a?c", "", false);
    name_case("a*b", "ab", true);
    name_case("notes.*", "abc", false);
    name_case("[abc].txt", "abcx", false);
